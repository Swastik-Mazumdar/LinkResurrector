# LinkResurrector engine — environment configuration
# Copy to .env and fill in optional keys. Everything works without them:
# discovery then uses Wayback + live redirects only (reduced coverage).

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1

# --- Recursive discovery budgets (Phase 11) --------------------------------
LR_MAX_DEPTH=4
LR_TIME_BUDGET_MS=90000
LR_MAX_CANDIDATES=6
LR_MAX_SNAPSHOTS_ANALYZED=4

# --- Per-request safety (Phase 12) ------------------------------------------
LR_FETCH_TIMEOUT_MS=12000
LR_MAX_RESPONSE_BYTES=524288
LR_MAX_REDIRECTS=8

# --- Caching / jobs ----------------------------------------------------------
LR_CACHE_TTL_MS=600000
LR_JOB_TTL_MS=3600000
LR_MAX_JOBS=200

# --- API abuse controls -------------------------------------------------------
LR_RATE_WINDOW_MS=60000
LR_RATE_MAX=20
LR_MAX_BODY_BYTES=16384

# --- Internet Archive ----------------------------------------------------------
LR_WAYBACK_INTERVAL_MS=1500
LR_CDX_MAX_ROWS=40

# --- Search providers (Phase 7) --------------------------------------------------
# Configure at least ONE for full discovery coverage. Official APIs only.
# Bing Web Search v7: https://api.bing.microsoft.com
BING_API_KEY=
# Google Programmable Search (CSE): needs BOTH the API key and the CSE id.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Logging -----------------------------------------------------------------------
# debug | info | warn | error
LR_LOG_LEVEL=info
