{
  "manifest_version": 3,
  "name": "LinkResurrector",
  "version": "1.0.0",
  "version_name": "1.0.0-alpha",
  "description": "Save, monitor and resurrect your links. Detect dead 404s and keep your bookmarks alive.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkResurrector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "alarms", "activeTab"]
}
